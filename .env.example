# PostgreSQL configuration used by docker-compose.yml
POSTGRES_DB=lablens
POSTGRES_USER=lablens
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_PORT=5433

# Spring Boot database connection
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/lablens
SPRING_DATASOURCE_USERNAME=lablens
SPRING_DATASOURCE_PASSWORD=replace-with-a-local-password

# monday.com demo integration
MONDAY_API_TOKEN=replace-with-a-demo-api-token
MONDAY_BOARD_ID=replace-with-a-demo-board-id
MONDAY_ASSIGNEE_COLUMN_ID=replace-with-an-assignee-column-id
MONDAY_SAMPLE_NAME_COLUMN_ID=replace-with-a-sample-name-column-id
MONDAY_ANALYST_DUE_COLUMN_ID=replace-with-a-due-date-column-id
MONDAY_STATUS_COLUMN_ID=replace-with-a-status-column-id
MONDAY_TAT_COLUMN_ID=replace-with-a-turnaround-time-column-id
MONDAY_QUEUE_STATUS_COLUMN_ID=replace-with-a-queue-status-column-id
